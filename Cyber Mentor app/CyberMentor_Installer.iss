; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "CyberMentor"
#define MyAppVersion "1.2.0"
#define MyAppPublisher "Isoqjonov Avazbek"
#define MyAppExeName "main.exe" 

[Setup]
; AppId o'zgarishsiz qoldi (yangilanish jarayoni to'g'ri ishlashi uchun)
AppId={{91C4DBF8-0F8A-40FF-9242-AE68C981BB4B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
OutputDir=C:\Users\avazb\Desktop\oxirgi
OutputBaseFilename=CyberMentor_Installer
SetupIconFile=C:\Users\avazb\Desktop\oxirgi\app_icon.ico
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Asosiy EXE fayl (dist ichidagi main.exe)
Source: "C:\Users\avazb\Desktop\oxirgi\dist\main.exe"; DestDir: "{app}"; Flags: ignoreversion

; Kerakli qo'shimcha fayllar
Source: "C:\Users\avazb\Desktop\oxirgi\creds.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\avazb\Desktop\oxirgi\cyber_config_v13.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\avazb\Desktop\oxirgi\app_icon.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent